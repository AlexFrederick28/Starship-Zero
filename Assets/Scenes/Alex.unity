  newDialogue:
  - topic: Initial Intro pt.1
    dialogueText:
    - Welcome aboard
    - 'WARNING: the ship has been infested with alien parasites, all power systems
      are failing'
    completedTopic: 0
    completedPrerequisite: 0
    isQuest: 0
    quest:
      description: 
      prerequisite:
        name: 
        id: 0
        complete: 0
  - topic: Initial Intro pt.2
    dialogueText:
    - I am the super computer and manager of this colony vessel
    - We must regain control by extinguishing the immediate threat and restoring
      power to the ships main systems
    - Please allow me to be your guide, I can direct you to this ships main pieces
      of infrastructure that will give you access to new weapons and cybernetic upgrades
    - These will prove to be necessary as the foe before us is no weak threat
    completedTopic: 0
    completedPrerequisite: 0
    isQuest: 0
    quest:
      description: 
      prerequisite:
        name: 
        id: 0
        complete: 0
  - topic: Tutorial pt.1
